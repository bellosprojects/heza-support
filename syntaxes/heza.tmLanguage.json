{
  "$schema": "https://raw.githubusercontent.com/microsoft/vscode-html-languageservice/master/docs/customData.schema.json",
  "name": "Heza",
  "version": 1.3,
  "patterns": [
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#expressions" },
    { "include": "#comments" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#function-definitions" },
    { "include": "#function-calls" },
    { "include": "#constants" },
    { "include": "#differentials" },
    { "include": "#system" },
    { "include": "#values" },
    { "include": "#variables" }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.heza",
          "match": "\\b(if|while|return|fun|else|use|copy|do|stop|true|false|object)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.heza",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.heza",
          "match": "\\\\."
        }
      ]
    },
    "expressions": {
      "name": "string.quoted.single.heza",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.heza",
          "match": "\\\\."
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.heza",
          "match": "~.*$"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.heza",
          "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b|\\b\\.\\d+([eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.heza",
          "match": "(>>|&&|\\|\\||>=|<=|==|!=|\\+\\+|--|\\+|\\*|-|/|\\^|%|<|>|=|:|∀|∃|∈|∑|∞|∅|!|∆|•|⨉|⋂|√|∪|≠|⊂|\\||→|←|∧|∨|¬|∫|∇|∄|∏|&|∉)"
        }
      ]
    },
    "function-definitions": {
      "patterns": [
        {
          "name": "meta.function.heza",
          "match": "\\b([a-zA-Z_]\\w*)\\s*\\(([^)]*)\\)\\s*(?==)",
          "captures": {
            "1": {
              "name": "entity.name.function.heza"
            },
            "2": {
              "name": "variable.parameter.heza"
            }
          }
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "meta.function-call.heza",
          "match": "\\b([a-zA-Z_]\\w*)\\s*\\(",
          "captures": {
            "1": {
              "name": "variable.function.heza"
            }
          }
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.heza",
          "match": "\\b(π|null|∅|true|false)\\b"
        }
      ]
    },
    "differentials": {
      "patterns": [
        {
          "name": "constant.other.differential.heza",
          "match": "\\bd[a-zA-Z]\\b"
        }
      ]
    },
    "system": {
      "patterns": [
        {
          "name": "support.class.heza",
          "match": "\\b(Sys)\\b"
        }
      ]
    },
    "values": {
      "patterns": [
        {
          "match": "(@)([a-zA-Z]\\w*)",
          "captures": {
            "1": { "name": "keyword.other.heza" },
            "2": { "name": "support.function.heza" }
          }
        },
        {
          "match": "(#)([a-zA-Z]\\w*)",
          "captures": {
            "1": { "name": "keyword.other.heza" },
            "2": { "name": "support.function.heza" }
          }
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.heza",
          "match": "\\b([a-zA-Z_]\\w*)\\b"
        }
      ]
    }
  },
  "scopeName": "source.heza"
}