{
  "name": "heza-support",
  "displayName": "Heza Support",
  "description": "Soporte de lenguaje Heza para VS Code con resaltado, LSP, diagnosticos, autocompletado y ejecucion de scripts",
  "version": "0.0.5",
  "type": "module",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "heza",
    "programming language",
    "language server",
    "lsp",
    "mathematics",
    "symbolic programming"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bellosprojects/heza-support.git"
  },
  "bugs": {
    "url": "https://github.com/bellosprojects/heza-support/issues"
  },
  "homepage": "https://github.com/bellosprojects/heza-support#readme",
  "galleryBanner": {
    "color": "#172033",
    "theme": "dark"
  },
  "icon": "icons/new_heza_logo.ico",
  "main": "./dist/extension.cjs",
  "scripts": {
    "bundle": "esbuild ./src/extension.js --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.cjs",
    "vscode:prepublish": "npm run bundle"
  },
  "activationEvents": [
    "onLanguage:heza",
    "onCommand:heza.runScript"
  ],
  "contributes": {
    "languages": [
      {
        "id": "heza",
        "aliases": [
          "Heza",
          "heza"
        ],
        "extensions": [
          ".hz"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "heza",
        "scopeName": "source.heza",
        "path": "./syntaxes/heza.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "heza",
        "path": "./snippets/heza.code-snippets.json"
      }
    ],
    "commands": [
      {
        "command": "heza.runScript",
        "title": "Ejecutar script Heza",
        "icon": "$(play)"
      }
    ],
    "keybindings": [
      {
        "command": "heza.runScript",
        "key": "ctrl+f5",
        "when": "editorLangId == heza"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "heza.runScript",
          "group": "navigation",
          "when": "editorLangId == heza"
        }
      ],
      "editor/title": [
        {
          "command": "heza.runScript",
          "group": "navigation",
          "when": "resourceLangId == heza"
        }
      ]
    }
  },
  "publisher": "bellosprojects",
  "author": {
    "name": "Bello's Projects",
    "email": "bello.angel1505@gmail.com"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "pnpm": "^12.8.1",
    "vsce": "^1.25.1",
    "esbuild": "^0.25.0",
    "vscode-languageclient": "^10.1.0"
  },
  "allowScripts": {
    "keytar@7.9.0": true,
    "@vscode/vsce-sign@2.1.0": true,
    "pnpm@12.8.1": true
  }
}
